    { "id": "both",   "col": 2, "row": 1, "icon": "merge",   "label": "Both gates open?", "sub": "and, not or" },
    { "id": "ghost",  "col": 3, "row": 0, "kind": "fail",    "icon": "cross",  "label": "Published, unreachable", "sub": "one gate shut" },
