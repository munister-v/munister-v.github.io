    { "id": "model", "col": 2, "row": 1, "icon": "cpu",     "label": "Local speech model", "sub": "smallest on purpose" },
    { "id": "slow",  "col": 3, "row": 0, "kind": "fail",    "icon": "clock",   "label": "Bigger model falls behind", "sub": "one core, no gpu" },
    { "id": "trans", "col": 3, "row": 1, "icon": "quote",   "label": "Straight to English", "sub": "one step, not two" },
    { "id": "show",  "col": 4, "row": 1, "icon": "eye",     "label": "Shown under the player", "sub": "as it arrives" }
  ],
  "edges": [
    { "from": "on",    "to": "cut" },
