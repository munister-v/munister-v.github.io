{
  "title": "Horreum: three writers, one journal, one derived total",
  "alt": "Three things change stock: a confirmed sale, an applied supplier import and a hand correction made in the panel. All three go through a single stock-change function that writes an append-only movement journal, after which the product total is recomputed as the sum of its variants and mirrored onto the product row. Availability is read from a variant above zero, crossing the low-stock threshold messages the operator, and turnover and dead-stock reports are read from the journal rather than kept as counters of their own.",
  "nodes": [
    { "id": "sale",   "col": 0, "row": 0, "kind": "trigger", "icon": "cart",    "label": "Sale confirmed", "sub": "one order line" },
    { "id": "import", "col": 0, "row": 1, "kind": "trigger", "icon": "hook",    "label": "Import applied", "sub": "supplier quantities" },
    { "id": "hand",   "col": 0, "row": 2, "kind": "trigger", "icon": "users",   "label": "Hand correction", "sub": "operator, with a reason" },
    { "id": "change", "col": 1, "row": 1, "icon": "sliders", "label": "One stock change", "sub": "set or delta" },
    { "id": "log",    "col": 2, "row": 1, "kind": "store",   "icon": "file",    "label": "Movement journal", "sub": "append only" },
    { "id": "sum",    "col": 3, "row": 1, "icon": "scale",   "label": "Recompute the product", "sub": "sum of its variants" },
    { "id": "mirror", "col": 4, "row": 1, "kind": "store",   "icon": "layers",  "label": "Mirror on the product", "sub": "derived, never typed" },
    { "id": "alert",  "col": 5, "row": 0, "icon": "bell",    "label": "Operator is told", "sub": "low stock message" },
    { "id": "avail",  "col": 5, "row": 1, "icon": "check",   "label": "Availability", "sub": "a cell above zero" },
    { "id": "report", "col": 5, "row": 2, "icon": "chart",   "label": "Turnover, dead stock", "sub": "read, never written" }
  ],
  "edges": [
    { "from": "sale",   "to": "change" },
    { "from": "import", "to": "change" },
    { "from": "hand",   "to": "change" },
    { "from": "change", "to": "log" },
    { "from": "log",    "to": "sum" },
    { "from": "sum",    "to": "mirror" },
    { "from": "mirror", "to": "avail" },
    { "from": "mirror", "to": "alert",  "kind": "weak", "label": "below threshold" },
    { "from": "log",    "to": "report", "kind": "weak", "label": "history" }
  ]
