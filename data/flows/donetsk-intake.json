    { "id": "no",    "col": 3, "row": 0, "kind": "fail",    "icon": "cross",  "label": "Refused", "sub": "nothing stored" },
    { "id": "re",    "col": 3, "row": 1, "icon": "image",   "label": "Decode, re-encode", "sub": "a clean new file" },
    { "id": "strip", "col": 4, "row": 2, "icon": "shield",  "label": "Original discarded", "sub": "and its metadata" },
